# Copy this file to .env and fill in your key.
# The key is only needed for answer generation (requires internet).
# Searching the manuals works without a key / without internet.

ANTHROPIC_API_KEY=

# Optional: which Claude model answers the questions (default is Sonnet 4.6).
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: a different embedding model (default is BAAI/bge-large-en-v1.5).
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Optional: OCR languages for scanned PDFs (default English). e.g. "eng" or "eng+rus".
# OCR_LANGUAGES=eng
